# 서버용 .env 예시. 실제 값은 서버에만 두고 깃에 커밋 금지

# backend VM (/opt/olympark/data-be/.env)
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://olympic:<비밀번호>@10.10.3.40:5432/olympicpark
CORS_ORIGINS=https://<dev 도메인>

# db VM (/opt/olympark/db/.env)
# POSTGRES_DB=olympicpark
# POSTGRES_USER=olympic
# POSTGRES_PASSWORD=<비밀번호>
# DB_LISTEN_ADDRESS=10.10.3.40
