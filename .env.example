# 복사해서 .env로 쓰고 값을 바꾸세요. .env는 깃에 올리지 않아요.
APP_ENV=local

# ===== DB 선택: 아래 두 묶음 중 하나만 주석을 풀어서 쓰세요 =====

# [1] 내 PC DB (도커로 db 컨테이너를 같이 띄움)
COMPOSE_PROFILES=local-db
DATABASE_URL=postgresql+psycopg://olympic:change-me@db:5432/olympicpark
RUN_MIGRATIONS=true

# [2] 공용 DB (팀이 같이 쓰는 DB, 주소와 계정은 팀 공지 참고)
#     공용 DB에서는 마이그레이션을 자동으로 돌리지 않아요. dev에 합쳐진 마이그레이션만 담당자가 적용해요.
# COMPOSE_PROFILES=
# DATABASE_URL=postgresql+psycopg://<사용자>:<비밀번호>@<공용 DB 주소>:5432/olympicpark
# RUN_MIGRATIONS=false

# 내 PC DB 컨테이너 계정 ([1]을 쓸 때만 필요, DATABASE_URL의 비밀번호와 같게)
POSTGRES_DB=olympicpark
POSTGRES_USER=olympic
POSTGRES_PASSWORD=change-me

# 프론트 주소, 쉼표로 구분 (data-fe nginx 8080, 프론트 개발 서버 5173)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# 내 PC에서 접속할 포트 (다른 프로젝트와 겹치면 바꾸세요)
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
